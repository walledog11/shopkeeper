{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [
    "scripts/lib/production-config-schema.d.mts",
    "scripts/with-test-env.d.mts"
  ],
  "ignoreBinaries": ["docker-compose", "ngrok"],
  "ignoreDependencies": ["@shopify/cli"],
  "rules": {
    "files": "error",
    "exports": "warn",
    "types": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "duplicates": "error"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,ts}", "e2e/**/*.{ts,cts}"],
      "project": ["scripts/**/*.{mjs,ts,d.mts}", "e2e/**/*.{ts,cts}"]
    },
    "apps/dashboard": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/scripts/**/*.ts",
        "next.config.js",
        "postcss.config.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["shadcn", "tailwindcss", "tw-animate-css"]
    },
    "apps/gateway": {
      "entry": ["src/{start,index,worker}.ts", "src/scripts/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/agent": {
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "project": ["*.ts"],
      "ignoreDependencies": ["@neondatabase/serverless"]
    },
    "packages/email": {
      "project": ["src/**/*.ts"]
    },
    "packages/analytics": {
      "project": ["src/**/*.ts"]
    }
  }
}
