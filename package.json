{
  "name": "shopkeeper-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "predev": "npm run db:generate -w packages/db && npm run build -w packages/db && npm run build -w packages/email && npm run build -w packages/agent && npm run build -w packages/analytics && npm run build -w packages/integrations",
    "dev": "npx turbo run dev",
    "build": "npx turbo run build",
    "clean": "node ./scripts/clean.mjs artifacts",
    "clean:deps": "node ./scripts/clean.mjs deps",
    "lint": "npm run lint:structure && npm run lint:repo && npm run lint:knip && npx turbo run lint",
    "lint:knip": "node ./scripts/check-knip-baseline.mjs",
    "typecheck": "npx turbo run typecheck",
    "lint:structure": "node ./scripts/check-module-structure.mjs && node ./scripts/check-test-config-overlap.mjs && node ./scripts/check-coverage-workspaces.mjs && node ./scripts/check-doc-references.mjs",
    "lint:repo": "eslint e2e scripts playwright.config.ts playwright.browser.config.ts eslint.config.mjs --max-warnings 0",
    "db:push": "npx turbo run db:push",
    "db:generate": "npx turbo run db:generate",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "test": "npm run test:unit && npm run test:node && npm run test:integration",
    "verify:pr": "node ./scripts/verify-pr.mjs",
    "test:unit": "npx turbo run test:unit --env-mode=loose",
    "test:node": "node --test scripts/*.test.mjs",
    "test:services:up": "node ./scripts/test-services.mjs up",
    "test:services:down": "node ./scripts/test-services.mjs down",
    "test:services:status": "node ./scripts/test-services.mjs status",
    "test:integration": "node ./scripts/test-bootstrap.mjs && npx turbo run test:integration --env-mode=loose",
    "test:coverage": "node ./scripts/test-bootstrap.mjs && npm run test:coverage -w apps/dashboard && npm run test:coverage -w apps/gateway && npm run test:coverage -w packages/agent && npm run test:coverage -w packages/analytics && npm run test:coverage -w packages/email && npm run test:coverage -w packages/integrations && node ./scripts/check-critical-coverage.mjs",
    "test:integration:local": "node ./scripts/test-integration-local.mjs",
    "test:e2e": "npm run test:e2e:smoke && npm run test:e2e:browser",
    "test:e2e:smoke": "E2E_AUTH_BYPASS=true node ./scripts/with-test-env.mjs npx playwright test --config=playwright.config.ts",
    "test:e2e:send-reply-hop": "E2E_AUTH_BYPASS=true node ./scripts/with-test-env.mjs npx playwright test e2e/internal-send-hop.spec.ts --config=playwright.config.ts",
    "test:e2e:browser": "E2E_AUTH_BYPASS=false node ./scripts/with-test-env.mjs npx playwright test --config=playwright.browser.config.ts",
    "configure:gmail-pubsub": "bash scripts/configure-gmail-pubsub.sh",
    "provision:posthog-reports": "node ./scripts/provision-posthog-reports.mjs",
    "verify:production:env": "node ./scripts/check-production-env.mjs all",
    "verify:production": "node ./scripts/verify-production.mjs",
    "verify:production:alerts": "node ./scripts/verify-production-alerts.mjs",
    "audit:instagram-rollout": "node ./scripts/audit-instagram-rollout.mjs",
    "audit:plan-executions": "node ./scripts/audit-plan-execution-rollout.mjs",
    "audit:operator-events": "node ./scripts/audit-operator-events.mjs",
    "audit:outbound-email": "node ./scripts/audit-outbound-email-rollout.mjs",
    "audit:stripe-webhooks": "node ./scripts/audit-stripe-webhook-events.mjs",
    "audit:shopify-webhooks": "tsx ./apps/gateway/src/scripts/inspect-shopify-webhooks.ts",
    "audit:refund-spend-reservations": "node ./scripts/audit-refund-spend-reservations.mjs",
    "audit:unknown-outcomes": "node ./scripts/audit-unknown-outcomes.mjs",
    "audit:production-dependencies": "npm audit --omit=dev --audit-level=high",
    "preview:seed": "node scripts/with-test-env.mjs node scripts/seed-preview-store.mjs",
    "demo:seed": "node scripts/seed-local-demo-store.mjs",
    "preview:serve": "E2E_AUTH_BYPASS=true E2E_AI_MODE=live node scripts/with-test-env.mjs npm run serve:e2e -w apps/dashboard",
    "preview:dev": "E2E_AUTH_BYPASS=true E2E_AI_MODE=live node scripts/with-test-env.mjs npm run dev:e2e -w apps/dashboard",
    "landing:media:fixture": "node scripts/seed-landing-media-store.mjs",
    "recover:gmail-history": "tsx ./scripts/recover-gmail-history.ts",
    "canary:agent-rollout": "tsx ./apps/gateway/src/scripts/canary-agent-rollout.ts",
    "canary:agent-briefings": "tsx ./apps/gateway/src/scripts/canary-agent-briefing.ts",
    "canary:classification": "tsx ./apps/gateway/src/scripts/canary-classification-write.ts",
    "canary:dashboard-ledger": "tsx --tsconfig apps/dashboard/tsconfig.json ./scripts/canary-plan-ledger.ts --surface=dashboard",
    "canary:gateway-ledger": "tsx ./scripts/canary-plan-ledger.ts --surface=gateway",
    "canary:lock-renewal": "tsx ./apps/gateway/src/scripts/canary-lock-renewal.ts",
    "canary:shopify-mutations": "node ./scripts/canary-shopify-mutations.mjs",
    "audit:tenant-consistency": "node ./scripts/audit-tenant-consistency.mjs",
    "validate:tenant-constraints": "node ./scripts/validate-tenant-consistency-constraints.mjs",
    "audit:escalation-backfill": "node ./scripts/audit-escalation-backfill.mjs",
    "audit:operator-context-compatibility": "node ./scripts/audit-operator-context-compatibility.mjs",
    "audit:agent-briefings": "node ./scripts/audit-agent-briefings.mjs",
    "audit:classification-alignment": "node ./scripts/audit-classification-alignment.mjs",
    "audit:request-outcomes": "node ./scripts/audit-request-outcomes.mjs",
    "audit:classification-recovery": "tsx ./apps/gateway/src/scripts/audit-classification-recovery.ts",
    "audit:legacy-imessage-threads": "node ./scripts/audit-legacy-imessage-threads.mjs",
    "cleanup:duplicate-integrations": "node ./scripts/cleanup-duplicate-integrations.mjs",
    "audit:bullmq-compatibility-names": "node ./scripts/audit-bullmq-compatibility-names.mjs",
    "audit:outbound-email-mode": "node ./scripts/audit-outbound-email-mode.mjs",
    "backfill:escalation": "node ./scripts/backfill-escalation.mjs",
    "verify:imessage:phase1-preflight": "node ./scripts/test-bootstrap.mjs && npm run test:integration -w apps/gateway -- --run src/routes/imessage/message-handler.test.ts src/routes/webhooks-meta-photon.test.ts src/operator-notify.test.ts src/operator-escalation.test.ts src/message-handlers/planning-notifications.test.ts && npm run test:integration -w apps/dashboard -- --run src/app/api/integrations/imessage/bind/route.test.ts",
    "verify:imessage:phase7": "npm run test:unit -w apps/dashboard -- --run src/lib/integrations/imessage-visibility.unit.test.ts src/lib/integrations/catalog.unit.test.ts src/app/\\(onboarding\\)/onboarding/_components/step-connect.unit.test.tsx && npm run test:integration -w apps/dashboard -- --run src/app/api/product-events/route.test.ts && npm run test:integration -w apps/gateway -- --run src/routes/imessage/binding.test.ts src/routes/imessage/message-handler.test.ts"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.22",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@shopify/cli": "^4.6.1",
    "@types/node": "^22.19.17",
    "@vercel/blob": "^2.3.3",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "globals": "^16.4.0",
    "knip": "^6.31.0",
    "prisma": "6.19.3",
    "turbo": "^2.9.5",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3",
    "js-cookie": "^3.0.6",
    "js-yaml": "^4.3.0",
    "nodemailer": "9.0.1",
    "sharp": "^0.35.0",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    },
    "concurrently": {
      "shell-quote": "1.10.0"
    },
    "next": {
      "postcss": "8.5.25"
    },
    "deepmerge-ts": "^8.0.1"
  }
}
