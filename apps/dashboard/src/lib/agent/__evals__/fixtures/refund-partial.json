{
  "id": "refund-partial",
  "description": "On a multi-item order, the customer wants money back for one damaged item and is keeping the other. The agent names the line item and lets Shopify price it without promising a figure.",
  "whyModelNeeded": "The model must identify the affected line item and distinguish an item-only refund from refunding the whole order.",
  "setup": {
    "classifierIntents": {
      "mutative_request": true
    },
    "channelType": "email",
    "tag": "Support",
    "customerName": "Theo Brooks",
    "customerPlatformId": "theo@example.com",
    "shopifyCustomerId": "10000001021",
    "shopify": {
      "shop": "test-store.myshopify.com",
      "accessToken": "shpat_test_fixture"
    },
    "messages": [
      {
        "senderType": "customer",
        "contentText": "Order #1021 - the candle arrived cracked but the tote is fine. I just want a refund for the candle and I'm keeping the tote. Thanks!"
      }
    ],
    "recentOrders": [
      {
        "id": "9000001021",
        "name": "#1021",
        "created_at": "2026-05-19T09:00:00-07:00",
        "financial_status": "paid",
        "fulfillment_status": "fulfilled",
        "total_price": "62.00",
        "currency": "USD",
        "items": [
          {
            "line_item_id": "lineitem_1021a",
            "title": "Soy Candle",
            "quantity": 1,
            "variant_id": "variant_1021a",
            "fulfillable_quantity": 0,
            "current_quantity": 1,
            "fulfillment_status": "fulfilled"
          },
          {
            "line_item_id": "lineitem_1021b",
            "title": "Canvas Tote",
            "quantity": 1,
            "variant_id": "variant_1021b",
            "fulfillable_quantity": 0,
            "current_quantity": 1,
            "fulfillment_status": "fulfilled"
          }
        ]
      }
    ],
    "simulateShopifyRest": [
      {
        "path": "orders/9000001021.json",
        "response": {
          "order": {
            "id": 9000001021,
            "name": "#1021",
            "currency": "USD",
            "financial_status": "paid",
            "refunds": [],
            "line_items": [
              {
                "id": "lineitem_1021a",
                "title": "Soy Candle",
                "quantity": 1,
                "current_quantity": 1,
                "price": "38.00"
              },
              {
                "id": "lineitem_1021b",
                "title": "Canvas Tote",
                "quantity": 1,
                "current_quantity": 1,
                "price": "24.00"
              }
            ]
          }
        }
      },
      {
        "method": "POST",
        "path": "orders/9000001021/refunds/calculate.json",
        "response": {
          "refund": {
            "currency": "USD",
            "transactions": [
              {
                "kind": "suggested_refund",
                "gateway": "shopify_payments",
                "parent_id": 7000001,
                "amount": "38.00",
                "currency": "USD"
              }
            ]
          }
        }
      }
    ]
  },
  "instruction": "Reply to the customer and process their refund request.",
  "expectedPlan": {
    "mustCallTools": [
      "create_partial_refund",
      "send_reply"
    ],
    "mustNotCallTools": [
      "create_refund",
      "create_gift_card",
      "cancel_order",
      "escalate_to_human"
    ],
    "mustCallToolsWithInput": [
      {
        "tool": "create_partial_refund",
        "inputEquals": {
          "order_id": "9000001021"
        }
      }
    ]
  },
  "expectedRubric": {
    "checks": [
      {
        "id": "refund_amount_not_stated",
        "description": "The reply does not state a specific refund amount or currency figure as the sum being returned. Shopify prices a partial refund, so naming a number would commit the merchant to an amount the agent did not calculate. Repeating the customer's own wording without asserting it as the refund total is acceptable; stating or confirming a figure as the amount refunded is not.",
        "gate": true
      }
    ]
  },
  "suite": "core"
}
