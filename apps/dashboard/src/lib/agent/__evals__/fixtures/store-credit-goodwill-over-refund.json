{
  "id": "store-credit-goodwill-over-refund",
  "description": "Customer explicitly requests exactly $12 of store credit. Customer-language store credit maps to a Shopify gift card attached to the resolved customer for delivery.",
  "setup": {
    "classifierIntents": {
      "mutative_request": true
    },
    "channelType": "email",
    "tag": "Support",
    "customerName": "Theo Lang",
    "customerPlatformId": "theo@example.com",
    "shopifyCustomerId": "10000007070",
    "shopify": {
      "shop": "test-store.myshopify.com",
      "accessToken": "shpat_test_fixture"
    },
    "messages": [
      {
        "senderType": "customer",
        "contentText": "One of the two jam jars in order #7070 arrived cracked. No need to send my money back - could you just put the $12 on my account as credit for my next order?"
      }
    ],
    "simulateToolResults": [
      {
        "tool": "create_gift_card",
        "result": "Created a $12.00 gift card and Shopify emailed it to the resolved customer."
      },
      {
        "tool": "send_reply",
        "result": "Reply sent to customer via email."
      }
    ],
    "recentOrders": [
      {
        "id": "9000007070",
        "name": "#7070",
        "created_at": "2026-06-28T10:00:00-07:00",
        "financial_status": "paid",
        "fulfillment_status": "fulfilled",
        "total_price": "24.00",
        "currency": "USD",
        "items": [
          {
            "line_item_id": "lineitem_7070",
            "title": "Strawberry Jam Jar",
            "quantity": 2,
            "variant_id": "710000007070",
            "fulfillable_quantity": 0,
            "current_quantity": 2,
            "fulfillment_status": "fulfilled"
          }
        ]
      }
    ]
  },
  "instruction": "Reply to the customer about the cracked jar.",
  "expectedPlan": {
    "mustCallTools": [
      "create_gift_card",
      "send_reply"
    ],
    "mustNotCallTools": [
      "create_refund",
      "issue_store_credit",
      "issue_discount",
      "cancel_order",
      "escalate_to_human"
    ],
    "mustCallToolsWithInput": [
      {
        "tool": "create_gift_card",
        "inputEquals": {
          "customer_id": "10000007070"
        },
        "moneyEquals": {
          "amount": "12.00"
        }
      }
    ]
  },
  "suite": "core"
}
