{
  "id": "refund-partial-placeholder",
  "description": "On a multi-item order, the customer wants money back for one damaged item and asks how much will go back on their card. Shopify prices the refund, so on runtime v2 the draft names the amount with the {{refund_amount}} placeholder, filled from the refund receipt after the write succeeds.",
  "whyModelNeeded": "The model must name a value it cannot know before the write by using the receipt placeholder, rather than calculating the figure itself or leaving the amount out.",
  "runtimeVersion": 2,
  "setup": {
    "classifierIntents": {
      "mutative_request": true
    },
    "channelType": "email",
    "tag": "Support",
    "customerName": "Theo Brooks",
    "customerPlatformId": "theo@example.com",
    "shopifyCustomerId": "10000001021",
    "shopify": {
      "shop": "test-store.myshopify.com",
      "accessToken": "shpat_test_fixture"
    },
    "messages": [
      {
        "senderType": "customer",
        "contentText": "Hi, order #1021 - the candle arrived cracked but the tote is fine and I'm keeping it. Could you refund just the candle and let me know how much will go back on my card?"
      }
    ],
    "recentOrders": [
      {
        "id": "9000001021",
        "name": "#1021",
        "created_at": "2026-05-19T09:00:00-07:00",
        "financial_status": "paid",
        "fulfillment_status": "fulfilled",
        "total_price": "62.00",
        "currency": "USD",
        "items": [
          {
            "line_item_id": "lineitem_1021a",
            "title": "Soy Candle",
            "quantity": 1,
            "variant_id": "variant_1021a",
            "fulfillable_quantity": 0,
            "current_quantity": 1,
            "fulfillment_status": "fulfilled"
          },
          {
            "line_item_id": "lineitem_1021b",
            "title": "Canvas Tote",
            "quantity": 1,
            "variant_id": "variant_1021b",
            "fulfillable_quantity": 0,
            "current_quantity": 1,
            "fulfillment_status": "fulfilled"
          }
        ]
      }
    ],
    "simulateShopifyRest": [
      {
        "path": "orders/9000001021.json",
        "response": {
          "order": {
            "id": 9000001021,
            "name": "#1021",
            "currency": "USD",
            "financial_status": "paid",
            "refunds": [],
            "line_items": [
              {
                "id": "lineitem_1021a",
                "title": "Soy Candle",
                "quantity": 1,
                "current_quantity": 1,
                "price": "38.00"
              },
              {
                "id": "lineitem_1021b",
                "title": "Canvas Tote",
                "quantity": 1,
                "current_quantity": 1,
                "price": "24.00"
              }
            ]
          }
        }
      },
      {
        "method": "POST",
        "path": "orders/9000001021/refunds/calculate.json",
        "response": {
          "refund": {
            "currency": "USD",
            "transactions": [
              {
                "kind": "suggested_refund",
                "gateway": "shopify_payments",
                "parent_id": 7000001,
                "amount": "38.00",
                "currency": "USD"
              }
            ]
          }
        }
      }
    ],
    "simulateToolResults": [
      {
        "tool": "create_partial_refund",
        "result": "Refund of $38.00 USD issued for order #1021.",
        "receipt": {
          "target": {
            "kind": "order",
            "id": "9000001021"
          },
          "providerReference": "refund_1021",
          "facts": {
            "orderId": "9000001021",
            "refundId": "refund_1021",
            "amount": "38.00",
            "currency": "USD",
            "transactionStatus": "SUCCESS",
            "transactionReference": "transaction_1021",
            "classification": "partial",
            "lineItems": [
              {
                "lineItemId": "lineitem_1021a",
                "quantity": 1
              }
            ]
          }
        }
      },
      {
        "tool": "send_reply",
        "result": "Reply sent to customer via email."
      }
    ]
  },
  "instruction": "Reply to the customer and process their refund request.",
  "expectedPlan": {
    "mustCallTools": [
      "create_partial_refund",
      "send_reply"
    ],
    "mustNotCallTools": [
      "create_refund",
      "create_gift_card",
      "cancel_order",
      "escalate_to_human"
    ],
    "mustBeValid": true,
    "mustCallToolsWithInput": [
      {
        "tool": "create_partial_refund",
        "inputEquals": {
          "order_id": "9000001021"
        }
      }
    ],
    "replyMustInclude": [
      "{{refund_amount}}"
    ],
    "replyMustNotInclude": [
      "38"
    ],
    "expectedAgentActions": [
      {
        "tool": "create_partial_refund",
        "status": "success",
        "mode": "human_approved"
      },
      {
        "tool": "send_reply",
        "status": "success",
        "mode": "human_approved"
      }
    ]
  },
  "suite": "core"
}
