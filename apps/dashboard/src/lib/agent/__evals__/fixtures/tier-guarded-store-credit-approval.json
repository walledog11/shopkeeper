{
  "id": "tier-guarded-store-credit-approval",
  "description": "Guarded tier: an explicitly requested fixed-value store-credit gift card is held for operator review and delivered to the resolved customer.",
  "setup": {
    "classifierIntents": {
      "mutative_request": true
    },
    "channelType": "email",
    "tag": "Support",
    "customerName": "Omar Haddad",
    "customerPlatformId": "omar@example.com",
    "shopifyCustomerId": "10000010101",
    "shopify": {
      "shop": "test-store.myshopify.com",
      "accessToken": "shpat_test_fixture"
    },
    "orgSettings": {
      "autonomyTier": "guarded"
    },
    "messages": [
      {
        "senderType": "customer",
        "contentText": "The candle set from order #10101 arrived with one candle snapped in half. Could you credit my account for it? It was $15 of the order. No refund needed, I shop with you all the time."
      }
    ],
    "simulateToolResults": [
      {
        "tool": "create_gift_card",
        "result": "Created a $15.00 gift card and Shopify emailed it to the resolved customer."
      },
      {
        "tool": "send_reply",
        "result": "Reply sent to customer via email."
      }
    ],
    "recentOrders": [
      {
        "id": "9000010101",
        "name": "#10101",
        "created_at": "2026-06-30T10:00:00-07:00",
        "financial_status": "paid",
        "fulfillment_status": "fulfilled",
        "total_price": "45.00",
        "currency": "USD",
        "items": [
          {
            "line_item_id": "lineitem_10101",
            "title": "Candle Trio Set",
            "quantity": 1,
            "variant_id": "710000010101",
            "fulfillable_quantity": 0,
            "current_quantity": 1,
            "fulfillment_status": "fulfilled"
          }
        ]
      }
    ]
  },
  "instruction": "Reply to the customer about the broken candle.",
  "expectedPlan": {
    "mustCallTools": [
      "create_gift_card",
      "send_reply"
    ],
    "mustNotCallTools": [
      "create_refund",
      "issue_store_credit",
      "escalate_to_human"
    ],
    "mustClassifyAs": "needs_review",
    "mustCallToolsWithInput": [
      {
        "tool": "create_gift_card",
        "inputEquals": {
          "customer_id": "10000010101"
        },
        "moneyEquals": {
          "amount": "15.00"
        }
      }
    ]
  },
  "suite": "extended"
}
