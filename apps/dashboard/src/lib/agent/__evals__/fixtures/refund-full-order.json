{
  "id": "refund-full-order",
  "description": "Customer asks for a full refund without naming an amount. The agent identifies the order and requests the refund while Shopify supplies the current refundable balance and currency.",
  "whyModelNeeded": "The model must understand an ordinary full-refund request and identify the correct order without calculating money.",
  "setup": {
    "classifierIntents": {
      "mutative_request": true
    },
    "channelType": "email",
    "tag": "Support",
    "customerName": "Jane Doe",
    "customerPlatformId": "jane@example.com",
    "shopifyCustomerId": "10000001010",
    "shopify": {
      "shop": "test-store.myshopify.com",
      "accessToken": "shpat_test_fixture"
    },
    "messages": [
      {
        "senderType": "customer",
        "contentText": "Hi, the tee was the wrong size and I don't want a replacement. Please give me a full refund for order #1010."
      }
    ],
    "simulateToolResults": [
      {
        "tool": "create_refund",
        "result": "Refund of $42.00 USD issued for order #1010."
      },
      {
        "tool": "send_reply",
        "result": "Reply sent to customer via email."
      }
    ],
    "recentOrders": [
      {
        "id": "9000001010",
        "name": "#1010",
        "created_at": "2026-05-15T10:00:00-07:00",
        "financial_status": "paid",
        "fulfillment_status": "fulfilled",
        "total_price": "42.00",
        "currency": "USD",
        "items": [
          {
            "line_item_id": "lineitem_1010",
            "title": "Cotton Tee",
            "quantity": 1,
            "variant_id": "variant_1010",
            "fulfillable_quantity": 0,
            "current_quantity": 1,
            "fulfillment_status": "fulfilled"
          }
        ]
      }
    ]
  },
  "instruction": "Reply to the customer and process their refund request.",
  "expectedPlan": {
    "mustCallTools": [
      "create_refund",
      "send_reply"
    ],
    "mustNotCallTools": [
      "escalate_to_human",
      "cancel_order"
    ],
    "mustCallToolsWithInput": [
      {
        "tool": "create_refund",
        "inputEquals": {
          "order_id": "9000001010"
        },
        "moneyEquals": {
          "amount": "42.00"
        }
      }
    ],
    "expectedAgentActions": [
      {
        "tool": "create_refund",
        "status": "success",
        "mode": "human_approved"
      },
      {
        "tool": "send_reply",
        "status": "success",
        "mode": "human_approved"
      }
    ]
  },
  "suite": "core"
}
