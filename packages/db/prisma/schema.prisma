// This is your Prisma schema file.
// It defines the universal data model for Shopkeeper.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// --- ENUMS ---
enum ChannelType {
  ig_dm
  email
  tiktok
  shopify
  sms
  sms_agent
  dashboard_agent
  imessage
  // Storefront chat (customer-origin). Distinct from `shopify`, which is the
  // merchant's store integration and its email-fallback behavior.
  shopify_chat
}

enum EmailProvider {
  gmail
  postmark
}

enum ThreadStatus {
  open
  pending
  closed
}

// Why a thread closed. `status` stays the lifecycle authority; this only records
// the reason. episode_rollover (a conversation boundary elapsed and a new episode
// opened) and inactivity (a quiet thread left the inbox for good) are distinct on
// purpose — collapsing them loses the difference between "they moved on to a new
// question" and "nobody ever came back".
enum ThreadClosedReason {
  merchant
  resolved
  episode_rollover
  inactivity
  superseded
}

// Disposition of the newest unanswered customer burst. Written by P2; only
// merchant_action and genuinely unresolved unclear may park work for the
// merchant.
enum ThreadRequestDisposition {
  none
  acknowledgement
  informational
  merchant_action
  unclear
}

enum SenderType {
  customer
  agent
  ai
  note
}

enum ThreadFilterStatus {
  genuine
  questionable
  filtered
}

enum ThreadFilterFeedback {
  none
  confirmed_genuine
  confirmed_spam
}

enum PlanExecutionStatus {
  pending
  claimed
  committed
  failed
  unknown
}

// Terminal resolution for one plan attempt on a customer request episode.
enum RequestEpisodeTerminalResolution {
  unresolved
  auto_resolved
  merchant_approved
  merchant_input
  escalated
  failed
  invalid_plan
  superseded
  dismissed
}

enum RequestEpisodeReplyProvenance {
  agent_automatic
  agent_approved
  manual
}

enum RefundSpendReservationStatus {
  reserved
  committed
  released
  unknown
}

enum OperatorEventStatus {
  pending
  claimed
  committed
  failed
  unknown
}

enum ReturnWatchStatus {
  open
  plan_pushed
  skipped
}

enum StripeWebhookEventStatus {
  pending
  processing
  completed
  failed
}

enum LifecycleOperationStatus {
  pending
  processing
  completed
  failed
}

enum OrganizationLifecycleStatus {
  active
  deleting
  deletion_failed
}

enum IntegrationLifecycleStatus {
  active
  disconnecting
  cleanup_failed
}

enum MerchantPreferenceCategory {
  compensation
  returns
  shipping
  policy
  general
}

enum MerchantPreferenceSource {
  explicit
  observed
}

enum MerchantPreferenceStatus {
  active
  proposed
  archived
  rejected
}

// --- MODELS ---

// One Organization = one Shopify business using the app.
// clerkOrgId maps to the organization ID from Clerk.com (e.g. org_xxxx).
model Organization {
  id                        String   @id @default(uuid()) @db.Uuid
  clerkOrgId                String   @unique @map("clerk_org_id")
  name                      String   @db.VarChar(255)
  settings                  Json?    @default("{}") @map("settings") @db.JsonB
  defaultEmailIntegrationId String?  @map("default_email_integration_id") @db.Uuid
  // Pending brand-voice update synthesized from operator edits, awaiting approval.
  // Shape: { brief, rationale, basedOnCount, createdAt }. Cleared on approve/dismiss.
  voiceProposal             Json?    @map("voice_proposal") @db.JsonB
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lifecycleStatus           OrganizationLifecycleStatus @default(active) @map("lifecycle_status")

  stripeCustomerId          String?   @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId      String?   @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId             String?   @map("stripe_price_id") @db.VarChar(255)
  stripeStatus              String?   @map("stripe_status") @db.VarChar(50)
  trialEndsAt               DateTime? @map("trial_ends_at") @db.Timestamptz
  stripeStateEventCreatedAt DateTime? @map("stripe_state_event_created_at") @db.Timestamptz
  stripeStateEventId        String?   @map("stripe_state_event_id") @db.VarChar(255)

  customers               Customer[]
  threads                 Thread[]
  integrations            Integration[]            @relation("OrganizationIntegrations")
  shopifyPrivacyRequests  ShopifyPrivacyRequest[]
  defaultEmailIntegration Integration?             @relation("DefaultEmailIntegration", fields: [defaultEmailIntegrationId], references: [id], onDelete: SetNull)
  members                 OrgMember[]
  operatorContexts        OperatorContext[]
  operatorEvents          OperatorEvent[]
  bindTokens              OrgMemberBindToken[]
  knowledgeBases          KnowledgeBase[]
  kbArticles              KbArticle[]
  kbCitations             KbCitation[]
  agentActions            AgentAction[]
  voiceEdits              VoiceEdit[]
  llmDailySpend           LlmDailySpend[]
  refundDailySpend        RefundDailySpend[]
  refundSpendReservations RefundSpendReservation[]
  shadowDecisions         AutonomyShadowDecision[]
  planExecutions          PlanExecution[]
  returnWatches           ReturnWatch[]
  stripeWebhookEvents     StripeWebhookEvent[]
  messages                Message[]
  storefrontChatSessions  StorefrontChatSession[]
  storefrontChatDailyUsage StorefrontChatDailyUsage[]
  storefrontChatVerifications StorefrontChatVerification[]
  storefrontChatSessionEpisodes StorefrontChatSessionEpisode[]
  conversationAttributions ConversationAttribution[]
  requestEpisodeOutcomes RequestEpisodeOutcome[]
  merchantPreferences    MerchantPreference[]
  agentTurnUsage         AgentTurnUsage[]

  @@index([clerkOrgId])
  @@index([lifecycleStatus])
  @@map("organizations")
}

// Durable, idempotent record for destructive work that spans PostgreSQL,
// Stripe, Clerk, and provider cleanup. It intentionally has no Organization
// relation so the audit/retry record survives the final organization delete.
model WorkspaceDeletion {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @unique @map("organization_id") @db.Uuid
  clerkOrgId            String                   @map("clerk_org_id") @db.VarChar(255)
  stripeSubscriptionId  String?                  @map("stripe_subscription_id") @db.VarChar(255)
  status                LifecycleOperationStatus @default(pending)
  claimToken            String?                  @map("claim_token") @db.Uuid
  claimedAt             DateTime?                @map("claimed_at") @db.Timestamptz
  attempts              Int                      @default(0)
  integrationsCleanedAt DateTime?                @map("integrations_cleaned_at") @db.Timestamptz
  stripeCanceledAt      DateTime?                @map("stripe_canceled_at") @db.Timestamptz
  clerkDeletedAt        DateTime?                @map("clerk_deleted_at") @db.Timestamptz
  localDataDeletedAt    DateTime?                @map("local_data_deleted_at") @db.Timestamptz
  lastError             String?                  @map("last_error") @db.Text
  completedAt           DateTime?                @map("completed_at") @db.Timestamptz
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, claimedAt])
  @@map("workspace_deletions")
}

// Durable processing record for Stripe webhooks. The signed event body is not
// retained; Stripe redelivers it when a failed/active claim returns a retryable
// response. Organization billing state and event completion commit together.
model StripeWebhookEvent {
  id              String                   @id @db.VarChar(255)
  type            String                   @map("event_type") @db.VarChar(255)
  stripeCreatedAt DateTime                 @map("stripe_created_at") @db.Timestamptz
  customerId      String?                  @map("customer_id") @db.VarChar(255)
  subscriptionId  String?                  @map("subscription_id") @db.VarChar(255)
  organizationId  String?                  @map("organization_id") @db.Uuid
  status          StripeWebhookEventStatus @default(pending)
  claimToken      String?                  @map("claim_token") @db.Uuid
  claimedAt       DateTime?                @map("claimed_at") @db.Timestamptz
  processedAt     DateTime?                @map("processed_at") @db.Timestamptz
  attempts        Int                      @default(0)
  lastError       String?                  @map("last_error") @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, claimedAt])
  @@index([organizationId, stripeCreatedAt])
  @@index([customerId, stripeCreatedAt])
  @@map("stripe_webhook_events")
}

// Per-org daily LLM spend backstop. One row per (org, UTC day) holding the
// running total in integer nano-dollars. Dashboard and gateway both upsert
// here so the daily cap is enforced per-org across both apps.
model LlmDailySpend {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  day            String   @map("day") @db.VarChar(10)
  model          String   @map("model") @db.VarChar(64)
  spentNanoUsd   BigInt   @default(0) @map("spent_nano_usd")
  calls          Int      @default(0) @map("calls")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day, model])
  @@map("llm_daily_spend")
}

// Per-org daily refund-cap backstop. One row per (org, UTC day) holding the
// running refund total in integer cents. Dashboard and gateway both upsert here
// so the daily refund cap is enforced per-org across both apps (the same reason
// llm_daily_spend lives in Postgres rather than per-instance Redis).
model RefundDailySpend {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  day            String   @map("day") @db.VarChar(10)
  spentCents     Int      @default(0) @map("spent_cents")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day])
  @@map("refund_daily_spend")
}

// One durable budget claim per goodwill-spend tool intent. Reservations count
// against the daily cap before the provider call; committed rows move their
// verified amount into RefundDailySpend, released rows free the capacity, and
// unknown rows keep capacity reserved until reconciliation proves an outcome.
model RefundSpendReservation {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  day            String                       @db.VarChar(10)
  operationKey   String                       @map("operation_key") @db.VarChar(255)
  tool           String                       @db.VarChar(64)
  input          Json                         @db.JsonB
  reservedCents  Int                          @map("reserved_cents")
  committedCents Int?                         @map("committed_cents")
  status         RefundSpendReservationStatus @default(reserved)
  lastError      String?                      @map("last_error") @db.Text
  resolvedAt     DateTime?                    @map("resolved_at") @db.Timestamptz
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day, operationKey])
  @@index([organizationId, day, status])
  @@index([status, updatedAt])
  @@map("refund_spend_reservations")
}

// Corpus for the brand-voice learning loop: each row is one case where the
// operator sent a customer reply that meaningfully diverged from the agent's
// drafted reply. A daily worker synthesizes these into a proposed brandVoice
// update (Organization.voiceProposal), then marks the consumed rows.
model VoiceEdit {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  threadId       String?   @map("thread_id") @db.Uuid
  aiDraft        String    @map("ai_draft") @db.Text
  finalText      String    @map("final_text") @db.Text
  tag            String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, consumedAt, createdAt])
  @@map("voice_edits")
}

// Stores a connected platform account for an organization.
// e.g. Instagram page, support email address, Shopify store.
model Integration {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  platform          ChannelType
  emailProvider     EmailProvider? @map("email_provider")
  externalAccountId String         @map("external_account_id") @db.VarChar(255)
  fromEmail         String?        @map("from_email") @db.VarChar(255)
  accessToken       String?        @map("access_token") @db.Text
  refreshToken      String?        @map("refresh_token") @db.Text
  tokenExpiresAt    DateTime?      @map("token_expires_at") @db.Timestamptz
  metadata          Json?          @default("{}") @db.JsonB
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  lifecycleStatus   IntegrationLifecycleStatus @default(active) @map("lifecycle_status")

  organization            Organization            @relation("OrganizationIntegrations", fields: [organizationId], references: [id], onDelete: Cascade)
  defaultForOrganizations Organization[]          @relation("DefaultEmailIntegration")
  replyThreads            Thread[]                @relation("ThreadReplyIntegration")
  messages                Message[]
  storefrontChatSessions  StorefrontChatSession[]
  storefrontChatDailyUsage StorefrontChatDailyUsage[]

  @@unique([organizationId, emailProvider])
  // Supporting identity for database-level tenant-consistency foreign keys.
  // The id remains the Prisma relation key; the compound index lets PostgreSQL
  // prove that a referenced integration belongs to the child row's tenant.
  @@unique([organizationId, id], map: "integrations_organization_id_id_key")
  // Non-email account uniqueness is enforced by the partial raw-SQL index
  // integrations_non_email_account_unique. Email rows are unique by provider
  // and may intentionally share the same external address.
  // Two further partial unique indexes Prisma cannot express keep one external
  // account tied to one workspace: integrations_instagram_account_unique and
  // integrations_shopify_account_unique, both on (external_account_id) filtered
  // by platform. They are the race-safe backstop for the connect-time guards.
  @@index([organizationId])
  @@index([organizationId, lifecycleStatus])
  @@map("integrations")
}

// Durable provider-cleanup record. It deliberately keeps scalar identifiers
// rather than a foreign key so completion/failure remains inspectable after
// the Integration row is removed. Provider credentials remain only on the
// encrypted Integration row while it is in `disconnecting` state.
model IntegrationDisconnect {
  id                 String                   @id @default(uuid()) @db.Uuid
  integrationId      String                   @unique @map("integration_id") @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  platform           ChannelType
  externalAccountId  String                   @map("external_account_id") @db.VarChar(255)
  status             LifecycleOperationStatus @default(pending)
  claimToken         String?                  @map("claim_token") @db.Uuid
  claimedAt          DateTime?                @map("claimed_at") @db.Timestamptz
  attempts           Int                      @default(0)
  providerCleanedAt  DateTime?                @map("provider_cleaned_at") @db.Timestamptz
  localDataDeletedAt DateTime?                @map("local_data_deleted_at") @db.Timestamptz
  lastError          String?                  @map("last_error") @db.Text
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId, createdAt])
  @@index([status, claimedAt])
  @@map("integration_disconnects")
}

// Durable intake ledger for Shopify's mandatory customers/data_request topic.
// The webhook cannot deliver the export in its HTTP response: Shopify requires
// the app to provide it directly to the store owner within 30 days. Pending
// rows drive that operator workflow. The authenticated export route marks them
// exported; completion remains a separate confirmation after direct delivery.
model ShopifyPrivacyRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  shopDomain          String    @map("shop_domain") @db.VarChar(255)
  topic               String    @db.VarChar(64)
  shopifyRequestId    String    @map("shopify_request_id") @db.VarChar(255)
  shopifyCustomerId   String?   @map("shopify_customer_id") @db.VarChar(255)
  customerEmail       String?   @map("customer_email") @db.VarChar(320)
  orderIds            String[]  @default([]) @map("order_ids")
  status              String    @default("pending") @db.VarChar(32)
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz
  exportedAt          DateTime? @map("exported_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([shopDomain, topic, shopifyRequestId])
  @@index([organizationId, status, receivedAt])
  @@index([status, receivedAt])
  @@map("shopify_privacy_requests")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String?   @db.VarChar(255)
  platformId     String    @map("platform_id") @db.VarChar(255)
  profilePicUrl  String?   @map("profile_pic_url") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  threads                Thread[]
  storefrontChatSessions StorefrontChatSession[]
  conversationAttributions ConversationAttribution[]
  requestEpisodeOutcomes RequestEpisodeOutcome[]

  // platformId is unique per org, not globally — two orgs can share the same customer email
  @@unique([organizationId, platformId])
  @@unique([organizationId, id], map: "customers_organization_id_id_key")
  @@index([organizationId])
  @@index([deletedAt])
  @@map("customers")
}

model Thread {
  id                        String               @id @default(uuid()) @db.Uuid
  organizationId            String               @map("organization_id") @db.Uuid
  customerId                String               @map("customer_id") @db.Uuid
  channelType               ChannelType          @map("channel_type")
  status                    ThreadStatus         @default(open)
  // Nullable by design: threads closed before conversation episodes shipped have
  // no recorded reason, and guessing one is worse than admitting it is unknown.
  closedReason              ThreadClosedReason?  @map("closed_reason")
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastMessageAt             DateTime             @default(now()) @map("last_message_at") @db.Timestamptz
  lastMessageSenderType     SenderType?          @map("last_message_sender_type")
  // Episode summary: background for this conversation only. It is never the
  // planning instruction or the notification delta — that is requestSummary.
  aiSummary                 String?              @map("ai_summary")
  aiTitle                   String?              @map("ai_title")
  // The newest unanswered customer burst, separate from the episode summary.
  // Written by P2; inert until then.
  requestSummary            String?                   @map("request_summary")
  requestSourceMessageId    String?                   @map("request_source_message_id") @db.Uuid
  requestDisposition        ThreadRequestDisposition? @map("request_disposition")
  subject                   String?
  tag                       String?              @default("Support")
  shopifyCustomerId         String?              @map("shopify_customer_id") @db.VarChar(255)
  operatorKey               String?              @map("operator_key")
  externalSpaceId           String?              @map("external_space_id")
  cachedPlanMessageId       String?              @map("cached_plan_message_id") @db.Uuid
  cachedPlan                Json?                @map("cached_plan") @db.JsonB
  archivedAt                DateTime?            @map("archived_at") @db.Timestamptz
  deletedAt                 DateTime?            @map("deleted_at") @db.Timestamptz
  // Escalation is orthogonal to lifecycle status (P5-04): an escalated ticket
  // stays `open` so it remains in the inbox and inbound follow-ups correlate to
  // it. Set when the agent hands off to the merchant; null otherwise.
  escalatedAt               DateTime?            @map("escalated_at") @db.Timestamptz
  filterStatus              ThreadFilterStatus   @default(genuine) @map("filter_status")
  filterReason              String?              @map("filter_reason") @db.Text
  filterDecidedAt           DateTime?            @map("filter_decided_at") @db.Timestamptz
  filterFeedback            ThreadFilterFeedback @default(none) @map("filter_feedback")
  classifierSignals         Json?                @map("classifier_signals") @db.JsonB
  replyIntegrationId        String?              @map("reply_integration_id") @db.Uuid
  replyIntegrationUpdatedAt DateTime?            @map("reply_integration_updated_at") @db.Timestamptz

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  replyIntegration Integration?             @relation("ThreadReplyIntegration", fields: [replyIntegrationId], references: [id], onDelete: SetNull)
  messages         Message[]
  kbCitations      KbCitation[]
  agentTurnUsage          AgentTurnUsage[]
  agentActions     AgentAction[]
  shadowDecisions  AutonomyShadowDecision[]
  planExecutions   PlanExecution[]
  returnWatches    ReturnWatch[]

  storefrontChatSessions StorefrontChatSession[]
  storefrontChatEpisodes StorefrontChatSessionEpisode[]
  conversationAttributions ConversationAttribution[]
  requestEpisodeOutcomes RequestEpisodeOutcome[]

  @@unique([organizationId, operatorKey])
  @@unique([organizationId, id], map: "threads_organization_id_id_key")
  // One open thread per customer per channel is enforced by the partial raw-SQL
  // index threads_one_open_per_customer, created in migration
  // 20260405000000_add_idempotency_and_thread_uniqueness on
  // (organization_id, customer_id, channel_type) where status = 'open'. It is
  // the database-level backstop for the race in the worker's findFirst → create
  // thread selection. Prisma cannot express the predicate, so `prisma migrate
  // dev` diffs it as absent and emits a DROP INDEX for it — hand-write every
  // migration against this schema.
  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@index([organizationId, status, lastMessageSenderType])
  @@index([customerId])
  @@index([organizationId, archivedAt, status])
  @@index([deletedAt])
  @@index([organizationId, filterStatus, filterDecidedAt(sort: Desc)])
  @@map("threads")
}

model Message {
  id                String     @id @default(uuid()) @db.Uuid
  threadId          String     @map("thread_id") @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  integrationId     String?    @map("integration_id") @db.Uuid
  senderType        SenderType @map("sender_type")
  contentText       String?    @map("content_text") @db.Text
  mediaUrl          String?    @map("media_url") @db.Text
  attachments       String[]   @default([])
  // Org-scoped idempotency for non-null provider message ids is enforced by
  // raw SQL migration 20260607000000_scope_message_idempotency_by_org.
  // Prisma cannot express the partial unique index:
  // messages_org_external_id_unique on (organization_id, external_message_id)
  // where external_message_id is not null.
  externalMessageId String?    @map("external_message_id") @db.Text
  sendStatus        String?    @map("send_status") @db.Text
  sendClaimToken    String?    @map("send_claim_token") @db.Uuid
  sendClaimedAt     DateTime?  @map("send_claimed_at") @db.Timestamptz
  sendAttemptedAt   DateTime?  @map("send_attempted_at") @db.Timestamptz
  providerMessageId String?    @map("provider_message_id") @db.Text
  sendError         String?    @map("send_error") @db.Text
  sentAt            DateTime   @default(now()) @map("sent_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

  thread               Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration          Integration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  sourcePlanExecutions PlanExecution[] @relation("PlanExecutionSourceMessage")
  requestEpisodeOutcomes RequestEpisodeOutcome[]

  @@unique([organizationId, id], map: "messages_organization_id_id_key")
  @@unique([organizationId, id, threadId], map: "messages_organization_id_id_thread_id_key")
  @@index([threadId])
  @@index([organizationId])
  @@index([integrationId])
  @@index([sendStatus, sendClaimedAt])
  @@index([sentAt])
  @@index([deletedAt])
  @@map("messages")
}

// Per-organization/*person* operator-channel state. `memberKey` is
// `member:<orgMemberId>` — one row per OrgMember, not per bound device, so a plan
// parked from any transport is the same plan every transport (Telegram, iMessage,
// the dashboard Concierge) shows and can resolve.
model OperatorContext {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  memberKey       String   @map("member_key") @db.VarChar(64)
  // Pending-plan queue: newest-last JSONB array, at most one entry per threadId,
  // trimmed to OPERATOR_PLAN_QUEUE_MAX. Nullable so an absent row reads as empty.
  pendingPlans    Json?    @map("pending_plans") @db.JsonB
  pendingDigest   Json?    @map("pending_digest") @db.JsonB
  pendingQuestion Json?    @map("pending_question") @db.JsonB
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, memberKey])
  @@index([organizationId])
  @@map("operator_contexts")
}

// Durable ingestion record for one inbound operator-channel message (P4-03). The
// webhook persists this row and enqueues before acknowledging, so an acknowledged
// merchant instruction survives a crash and is recoverable. The unique
// (channel, providerMessageId) absorbs provider redeliveries; the claim
// (pending -> claimed) makes each message drive at most one control action — the
// only single-use guard for free-form operator turns, which carry no plan claim.
// Turn commit (status/processedAt) is tracked separately from reply delivery
// (replyText/replyDeliveredAt) so a stuck confirmation can be re-sent without
// re-running the side-effectful turn.
model OperatorEvent {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  channel           String              @db.VarChar(16)
  providerMessageId String              @map("provider_message_id") @db.VarChar(255)
  chatId            String              @map("chat_id") @db.VarChar(255)
  spaceId           String?             @map("space_id") @db.VarChar(255)
  clerkUserId       String              @map("clerk_user_id") @db.VarChar(255)
  operatorKey       String              @map("operator_key") @db.VarChar(255)
  body              String              @db.Text
  metadata          Json?               @db.JsonB
  status            OperatorEventStatus @default(pending)
  claimToken        String?             @map("claim_token") @db.Uuid
  claimedAt         DateTime?           @map("claimed_at") @db.Timestamptz
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz
  replyText         String?             @map("reply_text") @db.Text
  replyDeliveredAt  DateTime?           @map("reply_delivered_at") @db.Timestamptz
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([channel, providerMessageId])
  @@index([organizationId, status, createdAt])
  @@index([status, updatedAt])
  @@map("operator_events")
}

// Extends Clerk.com org membership with operator-channel bindings so team
// members can interact with the AI agent over Telegram and iMessage.
model OrgMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clerkUserId    String   @map("clerk_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  telegramChats    OrgMemberTelegramChat[]
  imessageBindings OrgMemberImessageBinding[]

  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@map("org_members")
}

// One row per Telegram chat bound to an org member. A single member can have
// up to MAX_TELEGRAM_DEVICES (3) rows; a given chatId can only be bound to one
// member at a time (enforced by the unique constraint on chat_id).
model OrgMemberTelegramChat {
  id             String   @id @default(uuid()) @db.Uuid
  orgMemberId    String   @map("org_member_id") @db.Uuid
  chatId         String   @map("chat_id") @db.VarChar(64)
  telegramUserId String?  @map("telegram_user_id") @db.VarChar(64)
  displayName    String?  @map("display_name") @db.VarChar(255)
  username       String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

  @@unique([chatId])
  @@index([orgMemberId])
  @@map("org_member_telegram_chats")
}

// One row per iMessage sender handle bound to an org member. iMessage is an
// operator channel (mirrors Telegram): the merchant texts Shopkeeper's single
// platform Spectrum line and the agent replies. The binding resolves which org
// an inbound sender belongs to. senderId (the merchant's handle) is globally
// unique — one handle binds to one member at a time, matching
// OrgMemberTelegramChat.chatId. spaceId is the Spectrum space used to reply.
model OrgMemberImessageBinding {
  id          String   @id @default(uuid()) @db.Uuid
  orgMemberId String   @map("org_member_id") @db.Uuid
  senderId    String   @unique @map("sender_id") @db.VarChar(255)
  spaceId     String   @map("space_id") @db.VarChar(255)
  displayName String?  @map("display_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

  @@index([orgMemberId])
  @@map("org_member_imessage_bindings")
}

// Single-use deep-link tokens for binding operator channels (Telegram, iMessage).
// Stored in Postgres so dashboard (Upstash REST) and gateway (dedicated REDIS_URL)
// can both mint and consume tokens without sharing a Redis instance.
model OrgMemberBindToken {
  token          String   @id @db.VarChar(64)
  organizationId String   @map("organization_id") @db.Uuid
  clerkUserId    String   @map("clerk_user_id") @db.VarChar(255)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("org_member_bind_tokens")
}

model KnowledgeBase {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  source         String   @default("user") @db.VarChar(50)
  singletonKey   String?  @map("singleton_key") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     KbArticle[]

  @@unique([organizationId, id], map: "knowledge_bases_organization_id_id_key")
  @@unique([organizationId, singletonKey], map: "knowledge_bases_organization_id_singleton_key_key")
  @@index([organizationId])
  @@map("knowledge_bases")
}

model KbArticle {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid
  title           String   @db.VarChar(255)
  body            String   @db.Text
  tags            String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  citations     KbCitation[]

  @@unique([organizationId, id], map: "kb_articles_organization_id_id_key")
  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@map("kb_articles")
}

model KbCitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kbArticleId    String   @map("kb_article_id") @db.Uuid
  threadId       String?  @map("thread_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article      KbArticle    @relation(fields: [kbArticleId], references: [id], onDelete: Cascade)
  thread       Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([kbArticleId, createdAt])
  @@map("kb_citations")
}

// First-class audit record for every agent tool call. Replaces the
// __clerk_agent__ note-row parsing in lib/agent/api/action-log.ts.
//   status:   success | error | policy_block | escalated | unknown
//   mode:     human_approved | auto_executed | read_only
//   category: mirrors TOOL_CATEGORIES from lib/agent/tools/registry.ts
model AgentAction {
  id               String    @id @default(uuid()) @db.Uuid
  turnId           String    @map("turn_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  threadId         String?   @map("thread_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  executionId      String?   @map("execution_id") @db.Uuid
  providerOperationKey String? @map("provider_operation_key") @db.VarChar(255)
  tool             String    @db.VarChar(64)
  category         String    @db.VarChar(32)
  input            Json      @db.JsonB
  output           String?   @db.Text
  status           String    @db.VarChar(32)
  errorDetail      String?   @map("error_detail") @db.Text
  mode             String    @db.VarChar(32)
  instruction      String?   @db.Text
  summary          String?   @db.Text
  approverId       String?   @map("approver_id") @db.VarChar(255)
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz
  approvedPlanHash String?   @map("approved_plan_hash") @db.VarChar(64)
  instructionHash  String?   @map("instruction_hash") @db.VarChar(64)
  executedAt       DateTime  @default(now()) @map("executed_at") @db.Timestamptz
  durationMs       Int       @map("duration_ms")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       Thread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  execution    PlanExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  returnWatches ReturnWatch[]

  @@index([organizationId, executedAt(sort: Desc)])
  @@index([organizationId, threadId])
  @@index([organizationId, tool, executedAt])
  @@index([organizationId, status])
  @@index([providerOperationKey])
  @@index([turnId])
  @@index([executionId])
  @@map("agent_actions")
}

// Durable return↔ticket association for the return-lifecycle monitor (B3).
// Created when create_return/create_exchange succeeds; updated when Shopify
// closes the return and a plan-approval card is pushed. `arrived_at` is a legacy
// column name retained to avoid a destructive rename; it records observation of
// the terminal return state, not a carrier-confirmed warehouse arrival.
model ReturnWatch {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  threadId            String?           @map("thread_id") @db.Uuid
  sourceAgentActionId String?           @map("source_agent_action_id") @db.Uuid
  orderId             String            @map("order_id") @db.VarChar(32)
  shopifyReturnId     String            @map("shopify_return_id") @db.VarChar(128)
  returnName          String?           @map("return_name") @db.VarChar(64)
  tool                String            @db.VarChar(32)
  status              ReturnWatchStatus @default(open)
  arrivedAt           DateTime?         @map("arrived_at") @db.Timestamptz
  planPushedAt        DateTime?         @map("plan_pushed_at") @db.Timestamptz
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread            Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)
  sourceAgentAction AgentAction? @relation(fields: [sourceAgentActionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, shopifyReturnId])
  @@index([organizationId, status])
  @@index([organizationId, orderId])
  @@map("return_watches")
}

// Durable, cross-runtime identity and claim state for one reviewed agent plan.
// P1-01 adds this ledger additively; P1-02 makes every reviewed-plan entry point
// claim it before side effects. `observationCount` supports shadow rollout
// without treating timing locks as the correctness boundary.
model PlanExecution {
  id               String              @id @default(uuid()) @db.Uuid
  planId           String              @map("plan_id") @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  threadId         String?             @map("thread_id") @db.Uuid
  sourceMessageId  String?             @map("source_message_id") @db.Uuid
  planHash         String              @map("plan_hash") @db.VarChar(64)
  instructionHash  String              @map("instruction_hash") @db.VarChar(64)
  status           PlanExecutionStatus @default(pending)
  claimToken       String?             @map("claim_token") @db.Uuid
  claimedAt        DateTime?           @map("claimed_at") @db.Timestamptz
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz
  approverId       String?             @map("approver_id") @db.VarChar(255)
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz
  mode             String?             @db.VarChar(32)
  lastError        String?             @map("last_error") @db.Text
  observationCount Int                 @default(0) @map("observation_count")
  lastObservedAt   DateTime?           @map("last_observed_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread        Thread?       @relation(fields: [threadId], references: [id], onDelete: SetNull)
  sourceMessage Message?      @relation("PlanExecutionSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  actions       AgentAction[]
  requestEpisodeOutcomes RequestEpisodeOutcome[]

  @@unique([organizationId, planId])
  @@unique([organizationId, id], map: "plan_executions_organization_id_id_key")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, threadId, createdAt])
  @@index([sourceMessageId])
  @@map("plan_executions")
}

// Immutable attribution for one plan attempt on a customer request episode.
// `sourceMessageId` is the episode identity; `planId` distinguishes replaced
// plans on the same burst. Rows are append-only: terminal fields are set once.
model RequestEpisodeOutcome {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  threadId       String? @map("thread_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid
  sourceMessageId String @map("source_message_id") @db.Uuid
  planId         String @map("plan_id") @db.Uuid
  channelType    ChannelType @map("channel_type")

  classifierVersion  Int? @map("classifier_version")
  requestTag         String? @map("request_tag") @db.VarChar(64)
  requestDisposition ThreadRequestDisposition? @map("request_disposition")
  requestAsk         String? @map("request_ask") @db.VarChar(32)
  classifierIntents  Json? @map("classifier_intents") @db.JsonB

  planVerdict     String @map("plan_verdict") @db.VarChar(32)
  planHash        String @map("plan_hash") @db.VarChar(64)
  instructionHash String @map("instruction_hash") @db.VarChar(64)
  namespaceMiss   Boolean @default(false) @map("namespace_miss")

  planExecutionId String? @map("plan_execution_id") @db.Uuid
  executionStatus PlanExecutionStatus? @map("execution_status")

  approvalRequestedAt      DateTime? @map("approval_requested_at") @db.Timestamptz
  approvalGrantedAt        DateTime? @map("approval_granted_at") @db.Timestamptz
  merchantInputRequestedAt DateTime? @map("merchant_input_requested_at") @db.Timestamptz
  merchantInputAnsweredAt  DateTime? @map("merchant_input_answered_at") @db.Timestamptz
  escalatedAt              DateTime? @map("escalated_at") @db.Timestamptz
  replyProvenance          RequestEpisodeReplyProvenance? @map("reply_provenance")
  merchantTouched          Boolean @default(false) @map("merchant_touched")

  terminalResolution RequestEpisodeTerminalResolution @default(unresolved) @map("terminal_resolution")
  terminalAt         DateTime? @map("terminal_at") @db.Timestamptz
  supersededByPlanId String? @map("superseded_by_plan_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread        Thread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceMessage Message?       @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  planExecution PlanExecution? @relation(fields: [planExecutionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, planId], map: "request_episode_outcomes_organization_id_plan_id_key")
  @@index([organizationId, sourceMessageId])
  @@index([organizationId, threadId, createdAt(sort: Desc)])
  @@index([organizationId, terminalResolution, createdAt(sort: Desc)])
  @@index([organizationId, requestTag, createdAt(sort: Desc)])
  @@map("request_episode_outcomes")
}

// Org-scoped merchant judgment captured explicitly or proposed from observed
// behavior. Only `active` rows reach planning; `proposed` rows require confirmation.
model MerchantPreference {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  category       MerchantPreferenceCategory
  guidance       String                     @db.Text
  source         MerchantPreferenceSource
  status         MerchantPreferenceStatus   @default(active)
  confirmedAt    DateTime?                  @map("confirmed_at") @db.Timestamptz
  confirmedByClerkUserId String?            @map("confirmed_by_clerk_user_id") @db.VarChar(255)
  proposedRationale String?                 @map("proposed_rationale") @db.Text
  observedAt     DateTime?                  @map("observed_at") @db.Timestamptz
  lastUsedAt     DateTime?                  @map("last_used_at") @db.Timestamptz
  useCount       Int                        @default(0) @map("use_count")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, status, category])
  @@map("merchant_preferences")
}

// Shadow/canary record for the autonomy raise. One row per plan ("turn") that
// the classifier would have auto-executed at the org's tier while autoExecuteMode
// is "shadow": the action still routes to human approval, and we record what the
// agent *would* have auto-done so it can be compared against what the human did.
// The shadow unit is per-plan (turnId), unlike per-tool-call AgentAction.
model AutonomyShadowDecision {
  id                    String    @id @default(uuid()) @db.Uuid
  turnId                String    @unique @map("turn_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  threadId              String?   @map("thread_id") @db.Uuid
  tier                  String    @db.VarChar(16)
  proposedMutationsHash String    @map("proposed_mutations_hash") @db.VarChar(64)
  proposedTools         String[]  @map("proposed_tools")
  wouldAutoExecute      Boolean   @map("would_auto_execute")
  // pending | approved_unchanged | edited | rejected | escalated
  humanDecision         String    @default("pending") @map("human_decision") @db.VarChar(32)
  agreement             Boolean?  @map("agreement")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, humanDecision])
  @@index([organizationId, threadId, humanDecision])
  @@map("autonomy_shadow_decisions")
}

// One shopper's storefront chat session, keyed to the browser by a resume secret
// we only ever store hashed. Bootstrap creates the session; the customer and
// thread are created on the first actual message, so both stay null until then
// and an abandoned widget open costs one row and no ticket.
//
// M1 is guest-only: there are deliberately no token columns and no verified
// customer column. Verified sessions (M2) add those, and adding them here early
// would invite the guest path to read something it must never trust.
model StorefrontChatSession {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  integrationId    String    @map("integration_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  threadId         String?   @map("thread_id") @db.Uuid
  storefrontHost   String    @map("storefront_host") @db.VarChar(255)
  resumeSecretHash String    @map("resume_secret_hash") @db.VarChar(64)
  // Shopper messages accepted on this session, for the per-session budget. A
  // lifetime count rather than a daily one: the session itself expires, and a
  // shopper who clears it to reset the count lands on the per-shop daily budget
  // and the per-IP burst limit instead.
  messageCount     Int       @default(0) @map("message_count")
  // Verification emails sent from this session. Budgeted separately and far
  // tighter than messages: without its own ceiling the widget becomes a way to
  // mail-bomb whoever's address is on an order.
  verificationSends Int      @default(0) @map("verification_sends")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  // SHA-256 of the lowercased address the shopper proved control of, written on
  // the first successful verification. Storefront shoppers are otherwise
  // anonymous (`platformId` is `shopify_chat:<uuid>`), so this is the only
  // durable link between a browser session and a later order. Stored as a hash
  // because equality is all attribution needs — the address itself is already
  // on the order in Shopify and does not need a second home here.
  verifiedEmailHash String?  @map("verified_email_hash") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  thread       Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)

  verifications StorefrontChatVerification[]
  episodes      StorefrontChatSessionEpisode[]

  // Supporting identity for database-level tenant-consistency foreign keys,
  // matching the convention on integrations/customers/threads.
  @@unique([organizationId, id], map: "storefront_chat_sessions_organization_id_id_key")
  // Revocation on uninstall/disconnect sweeps by integration.
  @@index([integrationId, revokedAt])
  @@index([organizationId, lastSeenAt(sort: Desc)])
  @@index([expiresAt])
  @@map("storefront_chat_sessions")
}

// Per-shop-per-day shopper message counter — the storefront's own budget, and
// the only thing standing between an anonymous stranger and the org's daily LLM
// cap. Deliberately counted in messages, not dollars: the gate has to run
// *before* the model to be worth anything, and at that point the spend of the
// message being admitted is not yet known. One accepted message costs at most
// one classification, one summary and one plan, so a message ceiling is a spend
// ceiling with a known multiplier.
//
// Separate from `llm_daily_spend` on purpose. Exhausting this must degrade the
// widget alone and leave the merchant's email and Instagram agents running,
// which a shared counter cannot express.
// One row per (session, order) identity challenge. The row is the whole state
// machine: issued while `verifiedAt` is null, verified once it is set, and dead
// once `attempts` passes the ceiling. Codes are stored as a hash and never in
// the chat transcript — the code travels only to the address already on the
// order, which is the invariant the whole flow rests on.
// Which threads a browser session has held, in order. Two jobs: the widget's
// collapsed "Previous conversation" history, and the join that resolves
// storefront verification independently of the session's current thread pointer
// — so an episode rollover neither silently grants verified-order scope to the
// new episode nor silently revokes it from the expired one.
model StorefrontChatSessionEpisode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  threadId       String    @map("thread_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      StorefrontChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  thread       Thread                @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Binding a session to a thread it already holds must be idempotent, or a
  // retried inbound appends a duplicate episode and the widget renders the same
  // conversation twice.
  @@unique([sessionId, threadId], map: "storefront_chat_session_episodes_session_id_thread_id_key")
  @@index([threadId], map: "storefront_chat_session_episodes_thread_id_idx")
  @@index([sessionId, startedAt(sort: Desc)], map: "storefront_chat_session_episodes_session_id_started_at_idx")
  @@map("storefront_chat_session_episodes")
}

model StorefrontChatVerification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  // The order as the shopper names it (`#1026`), normalized with the leading #.
  orderName      String    @map("order_name") @db.VarChar(64)
  // Shopify's numeric order id, resolved at send time so a verified session
  // never has to re-resolve the name against a moving catalogue.
  orderId        String    @map("order_id") @db.VarChar(64)
  codeHash       String    @map("code_hash") @db.VarChar(64)
  // SHA-256 of the address on the order, captured when the code was mailed and
  // promoted onto the session's `verifiedEmailHash` only once a correct code
  // proves control. Writing the session hash at request time would let anyone
  // claim any address by naming an order and supplying a matching email.
  candidateEmailHash String? @map("candidate_email_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  attempts       Int       @default(0)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      StorefrontChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Re-requesting a code for the same order replaces the outstanding one rather
  // than leaving several valid at once.
  @@unique([sessionId, orderName])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("storefront_chat_verifications")
}

// One row per order the shop receives, classified by whether a conversation
// preceded it. Recording unattributed orders too is deliberate: "direct" is a
// number the merchant asked for, and it cannot be derived from a table that
// only holds the orders we managed to match.
//
// This is *attribution*, not causation — it records that a conversation
// happened before a purchase, and (for `product_assisted`) that the thing
// bought is a thing the agent put in front of the shopper. Neither proves the
// conversation caused the sale, and the reporting surface says so.
model ConversationAttribution {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  // Null for `direct` — there is no conversation to point at.
  threadId       String? @map("thread_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  orderId   String @map("order_id") @db.VarChar(64)
  orderName String @map("order_name") @db.VarChar(64)
  // Minor units. Shopify sends decimal strings; money is never carried as a
  // float here, and mixing currencies is guarded by grouping on `currency`.
  orderTotalCents Int    @map("order_total_cents")
  currency        String @db.VarChar(8)

  // direct | chat_assisted | product_assisted
  kind String @db.VarChar(32)
  // How the order was tied to a conversation: verified_email, customer_platform_id,
  // shopify_customer, or none for `direct`.
  matchBasis String @map("match_basis") @db.VarChar(32)
  // Shopify product ids that appear both in the order and in what the agent
  // surfaced during the conversation. Only set for `product_assisted`.
  matchedProductIds Json? @map("matched_product_ids") @db.JsonB

  // The last shopper activity on the matched thread, so the reporting surface
  // can show the gap between conversation and purchase without a second query.
  lastConversationAt DateTime? @map("last_conversation_at") @db.Timestamptz
  orderedAt          DateTime  @map("ordered_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Order webhooks retry, and orders/create can arrive more than once. One row
  // per order per org is what keeps revenue from being counted twice.
  @@unique([organizationId, orderId], map: "conversation_attributions_organization_id_order_id_key")
  @@index([organizationId, orderedAt(sort: Desc)])
  @@index([organizationId, kind, orderedAt(sort: Desc)])
  @@index([threadId])
  @@map("conversation_attributions")
}

model StorefrontChatDailyUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  integrationId  String   @map("integration_id") @db.Uuid
  // UTC day, `YYYY-MM-DD`, matching the llm_daily_spend convention.
  day            String   @db.VarChar(10)
  messageCount   Int      @default(0) @map("message_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, day])
  @@index([organizationId, day])
  @@map("storefront_chat_daily_usage")
}

// One row per completed agent turn: what it cost and why it stopped.
//
// `AgentAction` records what a turn *did*, but a turn that stops on
// `token_budget` before executing anything writes no action row at all -- so the
// turns most worth reading were the invisible ones. `llm_daily_spend` is the
// other half of the same gap: it aggregates by day and model, which cannot
// answer "did this turn open cold?".
model AgentTurnUsage {
  id             String  @id @default(uuid()) @db.Uuid
  turnId         String  @unique @map("turn_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  threadId       String? @map("thread_id") @db.Uuid
  purpose        String  @db.VarChar(32)
  channelType    String? @map("channel_type") @db.VarChar(32)
  // The agent-loop stop reason: end_turn, token_budget, max_iterations, ...
  outcome        String  @db.VarChar(32)
  modelCalls     Int     @map("model_calls")

  // The weighted figure TOKEN_BUDGET is compared against, and the same figure
  // after the first model call. The two separate the failure modes: a turn that
  // opens near the ceiling is a cache-temperature problem; one that climbs there
  // over many calls is a loop.
  budgetTokens          Int @map("budget_tokens")
  firstCallBudgetTokens Int @map("first_call_budget_tokens")

  inputTokens                Int @map("input_tokens")
  outputTokens               Int @map("output_tokens")
  cacheCreationInputTokens   Int @map("cache_creation_input_tokens")
  cacheCreation1hInputTokens Int @map("cache_creation_1h_input_tokens")
  cacheReadInputTokens       Int @map("cache_read_input_tokens")
  totalTokens                Int @map("total_tokens")

  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, outcome, createdAt(sort: Desc)])
  @@index([threadId])
  @@map("agent_turn_usage")
}
