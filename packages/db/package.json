{
  "name": "@shopkeeper/db",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./merchant-preferences": {
      "types": "./dist/merchant-preferences.d.ts",
      "default": "./dist/merchant-preferences.js"
    },
    "./test-helpers": {
      "types": "./dist/test-helpers.d.ts",
      "default": "./dist/test-helpers.js"
    },
    "./billing-write-gate": {
      "types": "./dist/billing-write-gate.d.ts",
      "default": "./dist/billing-write-gate.js"
    },
    "./product-analytics-workspace": {
      "types": "./dist/product-analytics-workspace.d.ts",
      "default": "./dist/product-analytics-workspace.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma && tsc",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "dev": "npm run db:generate && tsc --watch --preserveWatchOutput",
    "lint": "cd ../.. && eslint packages/db/*.ts --max-warnings 0",
    "test:integration": "node ../../scripts/with-test-env.mjs vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "typescript": "latest",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@shopkeeper/shared": "*",
    "@neondatabase/serverless": "0.10.4",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}
