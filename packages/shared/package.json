{
  "name": "@shopkeeper/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "default": "./dist/guards.js"
    },
    "./customer-labels": {
      "types": "./dist/customer-labels.d.ts",
      "default": "./dist/customer-labels.js"
    },
    "./product-analytics": {
      "types": "./dist/product-analytics.d.ts",
      "default": "./dist/product-analytics.js"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "default": "./dist/billing.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "default": "./dist/realtime.js"
    }
  },
  "scripts": {
    "postinstall": "tsc",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "cd ../.. && eslint packages/shared/src --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "latest",
    "vitest": "^4.1.3"
  }
}
