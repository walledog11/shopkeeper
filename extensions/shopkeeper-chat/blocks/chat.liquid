{% comment %}
  Shopkeeper storefront chat launcher. Mounts an isolated widget into a
  Shadow DOM so the theme's CSS cannot reach it and ours cannot leak out.
  All backend calls go through the app proxy at /apps/shopkeeper-chat, which
  Shopify signs — the widget never talks to app.useshopkeeper.com directly.

  The <span hidden> is load-bearing. Themes commonly ship a tidy-up rule like
  `div:empty { display: none }` (Dawn does), and a shadow root does NOT count as
  light-DOM children for :empty — so the host matches, gets display:none, and
  the entire widget silently collapses to 0x0 while every element inside it
  reports as visible. A light-DOM child that never renders (the shadow root
  replaces it, there is no slot) is what stops the rule matching. The JS also
  sets an inline display, because `div:empty` out-specifies `:host`.
{% endcomment %}

{% liquid
  assign panel_title = block.settings.panel_title | strip
  if panel_title == blank or panel_title == 'Use shop name'
    assign panel_title = shop.name
  endif

  assign logo_url = block.settings.logo | image_url: width: 64
  if block.settings.logo == blank and shop.brand.logo
    assign logo_url = shop.brand.logo | image_url: width: 64
  endif
  if block.settings.logo == blank and shop.brand.logo == blank
    assign logo_url = ''
  endif
%}

<div
  id="shopkeeper-chat-root"
  data-shop="{{ shop.permanent_domain }}"
  data-proxy="/apps/{{ block.settings.proxy_subpath | default: 'shopkeeper-chat' }}"
  data-greeting="{{ block.settings.greeting | escape }}"
  data-launcher-label="{{ block.settings.launcher_label | escape }}"
  data-panel-title="{{ panel_title | escape }}"
  data-status-line="{{ block.settings.status_line | escape }}"
  data-logo-url="{{ logo_url }}"
  data-prompts="{{ block.settings.quick_prompts | escape }}"
  data-accent="{{ block.settings.accent_color }}"
  data-position="{{ block.settings.position }}"
  data-page-url="{{ canonical_url }}"
><span hidden></span></div>

<script src="{{ 'shopkeeper-chat.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Shopkeeper Chat",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Launcher label",
      "default": "Chat with us"
    },
    {
      "type": "text",
      "id": "panel_title",
      "label": "Header title",
      "info": "Leave as “Use shop name” to show your shop name.",
      "default": "Use shop name"
    },
    {
      "type": "text",
      "id": "status_line",
      "label": "Status line",
      "default": "Typically replies in a few minutes"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Header logo",
      "info": "Optional. Falls back to your shop brand logo when set in Shopify admin."
    },
    {
      "type": "textarea",
      "id": "quick_prompts",
      "label": "Quick prompts",
      "info": "One per line. Shown before the shopper sends their first message.",
      "default": "What's your return policy?\nDo you ship internationally?"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting",
      "default": "Hi! Ask us anything about our products or policies."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "proxy_subpath",
      "label": "App proxy subpath",
      "info": "Only change this if the app proxy subpath was customized.",
      "default": "shopkeeper-chat"
    }
  ]
}
{% endschema %}
